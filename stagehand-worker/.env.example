# Copy to .env (git-ignored). The OpenRouter key arrives separately; never commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
PETZO_API_URL=http://localhost:8090
# Same value as INTERNAL_SECRET in the backend .env
INTERNAL_SECRET=
# false = visible Chrome window (useful while debugging)
HEADLESS=true
