# Copy to .env (git-ignored) and fill in. Never commit real values.
DB_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable/anon key: used only by the API to call Supabase Auth (the app and the panel never see it)
SUPABASE_ANON_KEY=
# service_role key: Storage and server-side writes, backend only
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /internal/** (n8n and the Stagehand worker send it as x-internal-secret)
INTERNAL_SECRET=
# OpenRouter for pre-evaluation and match (D-29); leave empty to run without AI
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
# Daily input+output token cap summed from ai_logs; above it AI and moderation fall back to manual review
AI_DAILY_TOKEN_CAP=2000000
N8N_MODERATION_WEBHOOK_URL=
N8N_NOTIFY_WEBHOOK_URL=
# Where the API may send the browser back after Google sign-in (comma-separated prefixes)
AUTH_REDIRECT_ALLOWLIST=exp://,petzo://,http://localhost:5173
# Hosts the import may download photos from (the demo foundation site)
IMPORT_ALLOWED_HOSTS=localhost
PORT=8090
